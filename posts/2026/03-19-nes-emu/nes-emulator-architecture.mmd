graph TB
    subgraph "Bevy App"
        MAIN[Main Loop<br/>60 FPS] --> EMU[Emulation System]
        MAIN --> VID[Video System]
        MAIN --> AUD[Audio System]
        MAIN --> INP[Input System]
        MAIN --> DBG[Debug UI]
    end

    subgraph "NES System"
        EMU --> SYS[nes_apu::System]
        SYS --> CPU[CPU<br/>6502]
        SYS --> PPU[PPU<br/>Framebuffer]
        SYS --> APU[APU<br/>5 Channels]
        SYS --> JOY[Joypad<br/>2 Players]
        CPU --> MAP[Mapper<br/>Bank Switch]
        PPU --> MAP
    end

    PPU -- "256×240 pixels" --> VID
    APU -- "PCM samples" --> AUD
    INP -- "button state" --> JOY