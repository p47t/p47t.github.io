      "width": 570,
      "height": 22,
      "text": "Multi-Port UART 硬體引導 (RP2040 · 48000 baud)",
      "fontSize": 15,
      "strokeColor": "#78350f",
      "textAlign": "center",
      "verticalAlign": "top"
    },
    {
      "id": "card-b1-desc",
      "type": "text",
      "x": 65,
      "y": 106,
      "width": 570,
      "height": 36,
      "text": "GPIO28(RX) / GPIO29(TX) / GPIO27(Reset) 觸發 BootROM 握手\n將 Sony 簽章的 fastboot.bin 載入至內部 SRAM 位址 0x92028000",
      "fontSize": 12.5,
      "strokeColor": "#334155",
      "textAlign": "center",
      "verticalAlign": "top"
    },
