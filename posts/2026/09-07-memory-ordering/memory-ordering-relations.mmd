    classDef proc fill:#1f2335,stroke:#414868,stroke-width:1.5px,color:#c0caf5;
    classDef sync fill:#24283b,stroke:#bb9af7,stroke-width:2px,color:#bb9af7;
    classDef safe fill:#24283b,stroke:#9ece6a,stroke-width:2px,color:#9ece6a;

    class A1,B2 proc;
