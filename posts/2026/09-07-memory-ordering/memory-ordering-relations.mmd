flowchart TD
    subgraph ThreadA["執行緒 A"]
        A1["一般變數寫入 data = 42"]
        A2["Release Store ready = true"]
        A1 -- "sequenced-before" --> A2
    end

    subgraph ThreadB["執行緒 B"]
        B1["Acquire Load ready == true"]
        B2["一般變數讀取 assert(data == 42)"]
        B1 -- "sequenced-before" --> B2
    end

    A2 -- "synchronizes-with<br/>(reads-from 成功配對)" --> B1
